# FastAPI backend (see backend/README.md). Requires MongoDB running locally
# and `python -m app.seed` to have been run once.
#
# 127.0.0.1 rather than localhost on purpose: on Windows localhost resolves
# to ::1 first, uvicorn listens on IPv4 only, and the browser spends ~2s on a
# refused IPv6 connection before falling back - which a large image POST does
# not always survive.
VITE_API_URL=http://127.0.0.1:8000/api
